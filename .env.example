# Configure in your shell or hosting environment; npm start does not load .env.
# Leave unset to use the existing DATA_DIR JSON / optional GitHub Gist storage.
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@DATABASE_HOST:5432/family_boggle
# Optional during first import and for additional Gist backups afterwards:
# GITHUB_TOKEN=YOUR_GIST_TOKEN
# GIST_ID=YOUR_EXISTING_GIST_ID
